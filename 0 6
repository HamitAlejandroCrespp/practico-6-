#include <iostream>
#include <cmath>
using namespace std;

void cuadraticaCompleta() {
    float a, b, c;
    cout << "Ingrese a, b y c: ";
    cin >> a >> b >> c;

    if (a == 0) {
        if (b != 0) {
            cout << "No es cuadratica. Solucion lineal x = " << -c / b << endl;
        } else {
            cout << "No hay solucion valida (0 = " << c << ")" << endl;
        }
    } else {
        float discriminante = (b * b) - (4 * a * c);
        if (discriminante > 0) {
            float x1 = (-b + sqrt(discriminante)) / (2 * a);
            float x2 = (-b - sqrt(discriminante)) / (2 * a);
            cout << "Soluciones reales: x1=" << x1 << " x2=" << x2 << endl;
        } else if (discriminante == 0) {
            float x = -b / (2 * a);
            cout << "Solucion unica: x=" << x << endl;
        } else {
            cout << "Las soluciones son imaginarias." << endl;
        }
    }
}

int main() {
    cuadraticaCompleta();
    return 0;
}
